# Copy to `simulator/.env` and fill in.
#
# NERVE_API_BASE is your Xano instance origin — no path, no trailing slash. The
# simulator appends `/api:ingest/...` itself.
NERVE_API_BASE=https://x8ki-letl-twmt.n7.xano.io

# An ingest API key. Create one in the Nerve UI under Admin -> API keys; the plaintext
# is shown exactly once, on creation. This is a DEVICE credential, not a user login —
# it never belongs in the frontend bundle.
NERVE_API_KEY=nrv_replace_me

# Optional: default fleet size when --devices is not passed.
NERVE_SIM_DEVICES=36
